---
import { t, path, type Lang } from '../i18n/ui';
import { nav } from '../lib/nav';
import { switchPath } from '../lib/routes';
import site from '../data/site.json';
import Emblem from './Emblem.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const bare = current.replace(/^\/en(?=\/|$)/, '') || '/';
const isActive = (href: string) => (href === '/' ? bare === '/' : bare.startsWith(href.split('/').slice(0, 2).join('/')));
const audiences = [
  { key: 'audience.prospective', href: '/admissions' },
  { key: 'audience.students', href: '/services/students' },
  { key: 'audience.staff', href: '/services/staff' },
  { key: 'audience.industry', href: '/contact' },
] as const;
---
<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-gold focus:px-4 focus:py-2 focus:text-maroon-deep">{t(lang, 'skip')}</a>

<div class="bg-maroon-dark text-sm text-parchment">
  <div class="container-site flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-2">
    <nav aria-label="audience" class="hidden flex-wrap gap-x-5 gap-y-1 md:flex">
      {audiences.map((a) => <a href={path(lang, a.href)} class="hover:text-gold-light">{t(lang, a.key)}</a>)}
    </nav>
    <div class="ml-auto flex items-center gap-4">
      <a href={site.deanHotlineUrl} target="_blank" rel="noopener" class="hover:text-gold-light">{t(lang, 'nav.complaint')}</a>
      <div class="flex overflow-hidden rounded-full border border-gold text-xs font-semibold">
        <a href={switchPath(Astro.url.pathname, 'th')} lang="th" class:list={['px-3 py-0.5', lang === 'th' ? 'bg-gold text-maroon-deep' : 'hover:text-gold-light']} aria-current={lang === 'th' ? 'true' : undefined}>TH</a>
        <a href={switchPath(Astro.url.pathname, 'en')} lang="en" class:list={['px-3 py-0.5', lang === 'en' ? 'bg-gold text-maroon-deep' : 'hover:text-gold-light']} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
      </div>
    </div>
  </div>
</div>

<header class="sticky top-0 z-40 border-b-[3px] border-gold bg-white/95 backdrop-blur">
  <div class="container-site flex items-center justify-between gap-6 py-3">
    <a href={path(lang, '/')} class="flex items-center gap-3 no-underline">
      <Emblem />
      <span class="flex flex-col leading-tight">
        <span class="font-serif text-lg font-bold text-maroon md:text-xl">{t(lang, 'faculty.name')}</span>
        <span class="text-xs text-muted md:text-[13px] xl:hidden 2xl:inline">{t(lang, 'faculty.sub')}</span>
      </span>
    </a>

    <nav aria-label="main" class="hidden xl:block">
      <ul class="flex items-center gap-0.5 whitespace-nowrap text-[14.5px] font-medium">
        {nav.slice(1).map((item) => (
          <li class="group relative">
            <a
              href={path(lang, item.href)}
              class:list={['block rounded px-2.5 py-2 hover:bg-cream hover:text-maroon', isActive(item.href) ? 'text-maroon' : 'text-ink']}
              aria-haspopup={item.children ? 'true' : undefined}
            >
              {t(lang, item.key)}
              {item.children && <span aria-hidden="true" class="ml-0.5 text-xs text-gold-ink">▾</span>}
            </a>
            {item.children && (
              <ul class="invisible absolute left-0 top-full z-50 min-w-64 translate-y-1 rounded-b-md border-t-2 border-gold bg-white py-2 opacity-0 shadow-lg transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                {item.children.map((c) => (
                  <li><a href={path(lang, c.href)} class="block px-4 py-2 text-sm text-ink hover:bg-cream hover:text-maroon">{t(lang, c.key)}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
        <li>
          <a href={path(lang, '/search')} class="block rounded p-2 hover:bg-cream" aria-label={t(lang, 'nav.search')}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7B1E2B" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
          </a>
        </li>
        <li><a href={path(lang, '/admissions')} class="ml-1 block rounded bg-maroon px-4 py-2 font-semibold text-white hover:bg-maroon-dark">{t(lang, 'cta.apply')}</a></li>
      </ul>
    </nav>

    <details class="group xl:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-2 rounded border border-line px-3 py-2 text-sm font-medium text-maroon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        {t(lang, 'nav.menu')}
      </summary>
      <div class="absolute inset-x-0 top-full max-h-[80vh] overflow-y-auto border-b-[3px] border-gold bg-white shadow-lg">
        <ul class="container-site py-3">
          {nav.map((item) => (
            <li class="border-b border-line last:border-0">
              <a href={path(lang, item.href)} class="block py-3 font-semibold text-ink">{t(lang, item.key)}</a>
              {item.children && (
                <ul class="pb-3 pl-4">
                  {item.children.map((c) => <li><a href={path(lang, c.href)} class="block py-1.5 text-sm text-muted">{t(lang, c.key)}</a></li>)}
                </ul>
              )}
            </li>
          ))}
          <li class="flex gap-3 py-4">
            <a href={path(lang, '/search')} class="flex-1 rounded border border-maroon px-4 py-2 text-center font-semibold text-maroon">{t(lang, 'nav.search')}</a>
            <a href={path(lang, '/admissions')} class="flex-1 rounded bg-maroon px-4 py-2 text-center font-semibold text-white">{t(lang, 'cta.apply')}</a>
          </li>
        </ul>
      </div>
    </details>
  </div>
</header>
