---
import { t, path, pick, type Lang } from '../i18n/ui';
interface Props { lang: Lang; program: any }
const { lang, program: p } = Astro.props;
---
<a href={path(lang, `/education/programs/${p.slug}`)} class="group flex h-full flex-col border-t-[3px] border-maroon bg-cream p-6 no-underline transition-colors hover:border-gold hover:bg-white">
  <span class="text-[15px] text-gold-ink">{pick(p.degree, lang)}</span>
  <span class="mt-1 font-serif text-[22px] leading-snug font-bold text-maroon">{pick(p.name, lang)}</span>
  <span class="mt-3 flex-1 text-muted">{pick(p.summary, lang)}</span>
  <dl class="mt-5 grid grid-cols-2 gap-4 border-t border-line pt-4 text-[15px]">
    <div><dt class="text-muted">{t(lang, 'label.duration')}</dt><dd class="font-semibold">{pick(p.duration, lang)}</dd></div>
    <div>
      <dt class="text-muted">{t(lang, 'label.fee')}</dt>
      <dd class="font-semibold">{p.status === 'pending' ? (lang === 'th' ? 'รออนุมัติหลักสูตร' : 'Awaiting approval') : `${p.fee.toLocaleString()} ${t(lang, 'label.baht')}${lang === 'th' ? '/ภาค' : '/term'}`}</dd>
    </div>
  </dl>
</a>
