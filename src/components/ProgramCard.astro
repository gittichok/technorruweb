---
import { t, path, pick, type Lang } from '../i18n/ui';
interface Props { lang: Lang; program: any }
const { lang, program: p } = Astro.props;
const groupLabel: Record<string, { th: string; en: string }> = {
  eng: { th: 'สายวิศวกรรม', en: 'Engineering' },
  tech: { th: 'สายเทคโนโลยี', en: 'Technology' },
  design: { th: 'สายออกแบบ', en: 'Design' },
};
---
<a href={path(lang, `/education/programs/${p.slug}`)} class="group flex h-full flex-col rounded-md border border-line bg-white p-6 no-underline transition hover:-translate-y-0.5 hover:border-gold hover:shadow-lg">
  <span class="mb-4 block h-1 w-10 bg-gold transition-all group-hover:w-16"></span>
  <span class="text-xs font-semibold tracking-wide text-gold-ink">{pick(groupLabel[p.group], lang)} · {pick(p.degree, lang)}</span>
  <span class="mt-1 font-serif text-xl font-bold text-maroon">{pick(p.name, lang)}</span>
  <span class="mt-2 flex-1 text-[15px] text-muted">{pick(p.summary, lang)}</span>
  <span class="mt-4 flex items-center justify-between border-t border-line pt-3 text-sm">
    <span class="text-muted">{pick(p.duration, lang)}</span>
    {p.status === 'pending'
      ? <span class="rounded-full bg-parchment px-2.5 py-0.5 text-xs font-semibold text-gold-ink">{lang === 'th' ? 'รออนุมัติ' : 'Pending approval'}</span>
      : <span class="font-semibold text-maroon">{p.fee.toLocaleString()} {t(lang, 'label.baht')}<span class="font-normal text-muted">{lang === 'th' ? '/ภาค' : '/term'}</span></span>}
  </span>
</a>
