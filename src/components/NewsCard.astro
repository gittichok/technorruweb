---
import { path, type Lang } from '../i18n/ui';
import { formatDate } from '../lib/routes';
interface Props { lang: Lang; item: any }
const { lang, item } = Astro.props;
---
<article class="group relative flex flex-col">
  <div class="aspect-[3/2] overflow-hidden bg-maroon-dark">
    {item.data.cover
      ? <img src={item.data.cover} alt="" loading="lazy" class="h-full w-full object-cover" />
      : <div class="blueprint h-full w-full"></div>}
  </div>
  <div class="flex flex-1 flex-col pt-4">
    <p class="flex flex-wrap gap-x-3 text-[15px]">
      <time datetime={item.data.date.toISOString().slice(0, 10)} class="text-muted">{formatDate(item.data.date, lang)}</time>
      {item.data.category && <span class="text-gold-ink">{item.data.category}</span>}
    </p>
    <h3 class="mt-1 text-lg leading-snug font-semibold">
      <a href={path(lang, `/news/${item.slug}`)} class="text-ink no-underline after:absolute after:inset-0 group-hover:text-maroon group-hover:underline group-hover:decoration-gold">{item.data.title}</a>
    </h3>
  </div>
</article>
