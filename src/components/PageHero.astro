---
import { t, path, type Lang } from '../i18n/ui';
interface Props { lang: Lang; title: string; eyebrow?: string; lead?: string; crumbs?: { label: string; href?: string }[] }
const { lang, title, eyebrow, lead, crumbs = [] } = Astro.props;
---
<section class="relative overflow-hidden bg-maroon text-white">
  <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full border-[40px] border-gold/15"></div>
  <div class="container-site relative py-12 md:py-16">
    <nav aria-label="breadcrumb" class="mb-4 text-sm text-parchment/90">
      <a href={path(lang, '/')} class="hover:text-gold-light">{t(lang, 'nav.home')}</a>
      {crumbs.map((c) => (
        <>
          <span class="mx-2 text-gold" aria-hidden="true">/</span>
          {c.href ? <a href={path(lang, c.href)} class="hover:text-gold-light">{c.label}</a> : <span>{c.label}</span>}
        </>
      ))}
    </nav>
    {eyebrow && <p class="mb-2 text-sm font-semibold tracking-[0.08em] text-gold-light">{eyebrow}</p>}
    <h1 class="font-serif text-3xl font-bold md:text-[42px] md:leading-tight">{title}</h1>
    {lead && <p class="mt-3 max-w-3xl text-lg text-parchment">{lead}</p>}
  </div>
  <div class="h-1 bg-gradient-to-r from-gold via-gold-light to-gold"></div>
</section>
