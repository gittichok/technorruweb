---
import { t, path, type Lang } from '../i18n/ui';
interface Props { lang: Lang; title: string; eyebrow?: string; lead?: string; crumbs?: { label: string; href?: string }[] }
const { lang, title, eyebrow, lead, crumbs = [] } = Astro.props;
---
<section class="blueprint text-white">
  <div class="container-site py-12 md:py-16">
    <nav aria-label="breadcrumb" class="mb-6 text-[15px] text-parchment/85">
      <a href={path(lang, '/')} class="hover:text-gold-light">{t(lang, 'nav.home')}</a>
      {crumbs.map((c) => (
        <>
          <span class="mx-2 text-gold/70" aria-hidden="true">/</span>
          {c.href ? <a href={path(lang, c.href)} class="hover:text-gold-light">{c.label}</a> : <span>{c.label}</span>}
        </>
      ))}
    </nav>
    {eyebrow && <p class="mb-2 text-[15px] text-gold-light">{eyebrow}</p>}
    <h1 class="max-w-4xl font-serif text-[34px] leading-tight font-bold md:text-[46px]">{title}</h1>
    {lead && <p class="mt-4 max-w-[60ch] text-lg text-parchment">{lead}</p>}
  </div>
  <div class="h-[3px] bg-gold"></div>
</section>
