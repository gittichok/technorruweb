---
import Base from '../../../../layouts/Base.astro';
import PageHero from '../../../../components/PageHero.astro';
import ProgramCard from '../../../../components/ProgramCard.astro';
import { t, pick } from '../../../../i18n/ui';
import { langPaths, langFromParam } from '../../../../lib/routes';
import programs from '../../../../data/programs.json';
export function getStaticPaths() { return langPaths(); }
const lang = langFromParam(Astro.params.lang);
const groups = [
  { key: 'eng', title: { th: 'สายวิศวกรรม (วศ.บ. 4 ปี)', en: 'Engineering (B.Eng., 4 years)' } },
  { key: 'tech', title: { th: 'สายเทคโนโลยี (ทล.บ. ต่อเนื่อง 2 ปี)', en: 'Technology (B.Tech. continuing, 2 years)' } },
  { key: 'design', title: { th: 'สายออกแบบ (วท.บ. 4 ปี)', en: 'Design (B.Sc., 4 years)' } },
];
---
<Base lang={lang} title={t(lang, 'nav.education.programs')}>
  <PageHero lang={lang} title={t(lang, 'nav.education.programs')} lead={lang === 'th' ? 'เลือกเส้นทางที่ใช่ จาก 7 หลักสูตร' : 'Choose your path from seven programs'}
    crumbs={[{ label: t(lang, 'nav.education'), href: '/education/programs' }, { label: t(lang, 'nav.education.programs') }]} />
  <div class="container-site space-y-12 py-12 md:py-16">
    {groups.map((g) => (
      <section>
        <h2 class="mb-5 font-serif text-2xl font-bold text-maroon">{pick(g.title, lang)}</h2>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {programs.programs.filter((p) => p.group === g.key).map((p) => <ProgramCard lang={lang} program={p} />)}
        </div>
      </section>
    ))}
  </div>
</Base>
