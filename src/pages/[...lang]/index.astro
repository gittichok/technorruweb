---
import Base from '../../layouts/Base.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import NewsCard from '../../components/NewsCard.astro';
import { t, path, pick } from '../../i18n/ui';
import { langPaths, langFromParam } from '../../lib/routes';
import { getNews } from '../../lib/content';
import programs from '../../data/programs.json';
import site from '../../data/site.json';
import people from '../../data/people.json';
import documents from '../../data/documents.json';

export function getStaticPaths() { return langPaths(); }
const lang = langFromParam(Astro.params.lang);
const news = (await getNews(lang)).slice(0, 3);
const dean = people.executives[0];
const L = (th: string, en: string) => (lang === 'th' ? th : en);

const gateways = [
  { title: t(lang, 'audience.prospective'), desc: L('หลักสูตร ค่าธรรมเนียม และการรับสมัคร', 'Programs, fees and admissions'), href: '/admissions' },
  { title: t(lang, 'audience.students'), desc: L('ระเบียบ แบบฟอร์ม คู่มือนักศึกษา', 'Regulations, forms and handbook'), href: '/services/students' },
  { title: t(lang, 'audience.staff'), desc: L('คู่มือปฏิบัติงาน แบบฟอร์ม ระบบสารสนเทศ', 'Manuals, forms and systems'), href: '/services/staff' },
  { title: t(lang, 'audience.industry'), desc: L('ความร่วมมือ บริการวิชาการ และ CWIE', 'Partnerships, services and CWIE'), href: '/contact' },
];
---
<Base lang={lang}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-maroon text-white">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_85%_20%,rgba(200,162,76,0.25),transparent_45%)]"></div>
    <div class="pointer-events-none absolute -bottom-40 -left-40 h-96 w-96 rounded-full border-[60px] border-gold/10"></div>
    <div class="container-site relative grid items-center gap-10 py-16 md:py-24 lg:grid-cols-[1.15fr_1fr]">
      <div>
        <span class="inline-block rounded-full border border-gold/60 px-4 py-1 text-sm text-gold-light">{L('ฉะเชิงเทรา · เขตพัฒนาพิเศษภาคตะวันออก (EEC)', 'Chachoengsao · Eastern Economic Corridor')}</span>
        <h1 class="mt-5 font-serif text-4xl font-bold leading-tight md:text-[46px] md:leading-[1.25]">
          {lang === 'th' ? <>สร้างนักเทคโนโลยีและวิศวกร<span class="text-gold-light">นักปฏิบัติ</span><br class="hidden md:block" /> เพื่ออุตสาหกรรมภาคตะวันออก</> : <>Hands-on engineers and technologists for <span class="text-gold-light">Eastern Thailand's industry</span></>}
        </h1>
        <p class="mt-5 max-w-xl text-lg text-parchment">
          {L('7 หลักสูตรด้านวิศวกรรม เทคโนโลยีอุตสาหกรรมอัจฉริยะ และการออกแบบ เรียนจากการปฏิบัติจริงร่วมกับสถานประกอบการ',
             'Seven programs in engineering, smart industrial technology and design, learned hands-on with industry partners.')}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={path(lang, '/education/programs')} class="rounded bg-gold px-6 py-3 font-semibold text-maroon-deep no-underline hover:bg-gold-light">{t(lang, 'cta.programs')}</a>
          <a href={site.applyUrl} target="_blank" rel="noopener" class="rounded border border-white/70 px-6 py-3 font-semibold text-white no-underline hover:bg-white hover:text-maroon">{L('สมัครเรียนปีการศึกษา 2570', 'Apply for 2027 intake')}</a>
        </div>
      </div>
      <div class="relative hidden lg:block">
        <div class="aspect-[4/3] rounded-md border border-gold/40 bg-maroon-dark/60 p-3 shadow-2xl">
          <div class="flex h-full w-full items-center justify-center rounded bg-[linear-gradient(135deg,#561420,#3a0e15)] text-center text-sm text-parchment/70">
            <img src="/images/hero.jpg" alt="" class="hidden h-full w-full rounded object-cover" onerror="this.remove()" onload="this.classList.remove('hidden'); this.nextElementSibling?.remove()" />
            <span class="px-8">{L('[ภาพนักศึกษาในห้องปฏิบัติการ วางไฟล์ public/images/hero.jpg]', '[Hero photo: public/images/hero.jpg]')}</span>
          </div>
        </div>
        <div class="absolute -bottom-5 -left-5 rounded bg-gold px-5 py-3 font-serif text-maroon-deep shadow-lg">
          <div class="text-2xl font-bold">{L('ใฝ่รู้ สู้งาน', 'Eager to learn')}</div>
        </div>
      </div>
    </div>
    <div class="h-1 bg-gradient-to-r from-gold via-gold-light to-gold"></div>
  </section>

  <!-- Audience gateways + stats -->
  <section class="bg-cream">
    <div class="container-site py-10">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {gateways.map((g) => (
          <a href={path(lang, g.href)} class="group rounded-md border border-line bg-white p-5 no-underline transition hover:border-gold hover:shadow-md">
            <span class="block font-semibold text-maroon">{g.title} <span class="inline-block transition group-hover:translate-x-1">→</span></span>
            <span class="mt-1 block text-sm text-muted">{g.desc}</span>
          </a>
        ))}
      </div>
      <dl class="mt-8 grid grid-cols-2 gap-6 border-t border-line pt-8 md:grid-cols-4">
        {site.stats.map((s) => (
          <div class="flex flex-col-reverse text-center">
            <dt class="text-sm text-muted">{pick(s.label, lang)}</dt>
            <dd class="font-serif text-4xl font-bold text-maroon">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Programs -->
  <section class="container-site py-16 md:py-20">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">{t(lang, 'home.programs.eyebrow')}</p>
        <h2 class="section-title mt-1">{t(lang, 'home.programs.title')}</h2>
      </div>
      <a href={path(lang, '/education/programs')} class="font-semibold text-maroon">{t(lang, 'cta.programs')} →</a>
    </div>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {programs.programs.map((p) => <ProgramCard lang={lang} program={p} />)}
      <a href={path(lang, '/education/why-us')} class="flex flex-col justify-center rounded-md bg-maroon p-6 text-white no-underline hover:bg-maroon-dark">
        <span class="font-serif text-xl font-bold text-gold-light">{t(lang, 'nav.education.why')}</span>
        <span class="mt-2 text-sm text-parchment">{L('เรียนรู้จากการลงมือทำ ร่วมกับสถานประกอบการในพื้นที่ EEC', 'Learn by doing with industry partners in the EEC')}</span>
        <span class="mt-4 font-semibold">→</span>
      </a>
    </div>
  </section>

  <!-- News -->
  <section class="bg-cream">
    <div class="container-site py-16 md:py-20">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">{t(lang, 'home.news.eyebrow')}</p>
          <h2 class="section-title mt-1">{t(lang, 'home.news.title')}</h2>
        </div>
        <a href={path(lang, '/news')} class="font-semibold text-maroon">{t(lang, 'cta.allNews')} →</a>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {news.map((n) => <NewsCard lang={lang} item={n} />)}
      </div>
    </div>
  </section>

  <!-- Quality -->
  <section class="container-site py-16 md:py-20">
    <div class="mb-8 text-center">
      <p class="eyebrow">{t(lang, 'home.quality.eyebrow')}</p>
      <h2 class="section-title mt-1">{t(lang, 'home.quality.title')}</h2>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {documents.quality.map((q) => (
        <a href={q.url || path(lang, '/quality')} class="flex items-start gap-4 rounded-md border border-line p-5 no-underline transition hover:border-gold hover:bg-cream">
          <span class="mt-1 h-3 w-3 shrink-0 rotate-45 bg-gold"></span>
          <span>
            <span class="block font-semibold text-maroon">{pick(q.title, lang)}</span>
            <span class="block text-sm text-muted">{pick(q.desc, lang)}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Dean -->
  <section class="bg-maroon-deep text-white">
    <div class="container-site grid items-center gap-10 py-16 md:grid-cols-[280px_1fr]">
      <div class="mx-auto h-64 w-64 overflow-hidden rounded-full border-4 border-gold bg-maroon-dark">
        {dean.photo ? <img src={dean.photo} alt={pick(dean.name, lang)} class="h-full w-full object-cover" /> : <div class="flex h-full items-center justify-center text-sm text-parchment/60">{L('[ภาพคณบดี]', '[Dean photo]')}</div>}
      </div>
      <div>
        <p class="text-sm font-semibold tracking-[0.08em] text-gold-light">{t(lang, 'home.dean.eyebrow')}</p>
        <blockquote class="mt-3 font-serif text-2xl leading-relaxed md:text-[28px]">
          {L('“มุ่งเป็นเลิศด้านเทคโนโลยีและวิศวกรรมนักปฏิบัติของภาคตะวันออก สร้างบัณฑิตที่ทำงานได้จริง และเติบโตไปพร้อมกับอุตสาหกรรมในบ้านเกิด”',
             '“We aim to lead the East in hands-on technology and engineering, producing graduates who can do the work and grow with industry at home.”')}
        </blockquote>
        <div class="mt-5">
          <div class="font-semibold text-gold-light">{pick(dean.name, lang)}</div>
          <div class="text-sm text-parchment">{pick(dean.position, lang)}</div>
        </div>
        <div class="mt-6 flex flex-wrap gap-5 text-sm">
          <a href={path(lang, '/about/executives')} class="text-white underline decoration-gold underline-offset-4">{t(lang, 'nav.about.executives')} →</a>
          <a href={site.deanHotlineUrl} target="_blank" rel="noopener" class="text-white underline decoration-gold underline-offset-4">{t(lang, 'nav.dean')} →</a>
        </div>
      </div>
    </div>
  </section>
</Base>
