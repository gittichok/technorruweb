---
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import { t, path, pick } from '../../i18n/ui';
import { langPaths, langFromParam } from '../../lib/routes';
import { getNews } from '../../lib/content';
import programs from '../../data/programs.json';
import site from '../../data/site.json';
import people from '../../data/people.json';
import documents from '../../data/documents.json';

export function getStaticPaths() { return langPaths(); }
const lang = langFromParam(Astro.params.lang);
const news = (await getNews(lang)).slice(0, 3);
const dean = people.executives[0];
const L = (th: string, en: string) => (lang === 'th' ? th : en);

const tracks = [
  { key: 'eng', title: { th: 'สายวิศวกรรม', en: 'Engineering' }, note: { th: 'วศ.บ. 4 ปี', en: 'B.Eng., 4 years' } },
  { key: 'tech', title: { th: 'สายเทคโนโลยี', en: 'Technology' }, note: { th: 'ทล.บ. ต่อเนื่อง 2 ปี สำหรับผู้จบ ปวส.', en: 'B.Tech. continuing, 2 years, for vocational graduates' } },
  { key: 'design', title: { th: 'สายออกแบบ', en: 'Design' }, note: { th: 'วท.บ. 4 ปี', en: 'B.Sc., 4 years' } },
];
const feeText = (p: any) => p.status === 'pending' ? L('รออนุมัติหลักสูตร', 'Awaiting approval') : `${p.fee.toLocaleString()} ${t(lang, 'label.baht')}${L('/ภาค', '/term')}`;
const gateways = [
  { title: t(lang, 'audience.prospective'), desc: L('หลักสูตร ค่าธรรมเนียม และการรับสมัคร', 'Programs, fees and admissions'), href: '/admissions' },
  { title: t(lang, 'audience.students'), desc: L('ระเบียบ แบบฟอร์ม คู่มือนักศึกษา', 'Regulations, forms and handbook'), href: '/services/students' },
  { title: t(lang, 'audience.staff'), desc: L('คู่มือปฏิบัติงาน แบบฟอร์ม ระบบสารสนเทศ', 'Manuals, forms and systems'), href: '/services/staff' },
  { title: t(lang, 'audience.industry'), desc: L('ความร่วมมือ บริการวิชาการ และ CWIE', 'Partnerships, services and CWIE'), href: '/contact' },
];
---
<Base lang={lang}>
  <!-- Hero: กระดาษเขียนแบบ -->
  <section class="blueprint text-white">
    <div class="container-site grid items-center gap-12 py-16 md:py-24 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <h1 class="font-serif text-[36px] leading-[1.25] font-bold md:text-[48px]">
          {L('สร้างนักเทคโนโลยีและวิศวกรนักปฏิบัติ เพื่ออุตสาหกรรมภาคตะวันออก', 'Hands-on engineers and technologists for Eastern Thailand')}
        </h1>
        <p class="mt-6 max-w-[52ch] text-lg text-parchment">
          {L('เรียนจากการลงมือทำร่วมกับสถานประกอบการ ที่ฉะเชิงเทรา ใจกลางเขตพัฒนาพิเศษภาคตะวันออก (EEC) 7 หลักสูตร ทั้งวิศวกรรม เทคโนโลยี และการออกแบบ',
             'Learn by doing with industry partners in Chachoengsao, at the heart of the Eastern Economic Corridor. Seven programs in engineering, technology and design.')}
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={site.applyUrl} target="_blank" rel="noopener" class="rounded-sm bg-gold px-6 py-3 font-semibold text-maroon-deep no-underline hover:bg-gold-light">{L('สมัครเรียนปีการศึกษา 2570', 'Apply for 2027 intake')}</a>
          <a href={path(lang, '/education/programs')} class="rounded-sm border border-white/60 px-6 py-3 font-semibold text-white no-underline hover:border-white hover:bg-white/10">{t(lang, 'cta.programs')}</a>
        </div>
      </div>
      <figure class="relative">
        <div class="border border-gold/50 p-2">
          <img src={site.heroImage} alt={L('นักศึกษาคณะเทคโนโลยีอุตสาหกรรมในกิจกรรมของคณะ', 'Students at a faculty activity')} class="aspect-[4/3] w-full object-cover" />
        </div>
        <figcaption class="mt-3 flex items-baseline justify-between gap-4 text-[15px] text-parchment/85">
          <span>{L('บัณฑิตที่', 'Graduates who are')} <span class="font-serif text-lg font-bold text-gold-light">{L('ใฝ่รู้ สู้งาน', 'eager to learn, ready to work')}</span></span>
          <span class="hidden sm:inline">{L('ก่อตั้ง พ.ศ. 2542', 'Founded 1999')}</span>
        </figcaption>
      </figure>
    </div>
    <div class="h-[3px] bg-gold"></div>
  </section>

  <!-- ทางเข้าตามกลุ่มผู้ใช้ -->
  <nav aria-label={L('ข้อมูลตามกลุ่มผู้ใช้', 'Information for')} class="border-b border-line bg-cream">
    <ul class="container-site grid sm:grid-cols-2 lg:grid-cols-4">
      {gateways.map((g) => (
        <li class="border-line sm:odd:border-r lg:border-r lg:last:border-r-0">
          <a href={path(lang, g.href)} class="block px-1 py-5 no-underline sm:px-6 lg:first:pl-0">
            <span class="block font-semibold text-maroon hover:underline hover:decoration-gold">{g.title}</span>
            <span class="block text-[15px] text-muted">{g.desc}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- หลักสูตร: จัดตามสาย -->
  <section class="container-site py-16 md:py-24">
    <div class="grid gap-6 lg:grid-cols-[1fr_1.4fr] lg:items-end">
      <h2 class="section-title">{t(lang, 'home.programs.title')}</h2>
      <p class="max-w-[60ch] text-muted lg:justify-self-end">
        {L('ทุกหลักสูตรเรียนร่วมกับสถานประกอบการผ่านสหกิจศึกษาและ CWIE ค่าธรรมเนียมเหมาจ่ายต่อภาคการศึกษา', 'Every program includes cooperative education with industry. Fees are a flat rate per term.')}
      </p>
    </div>
    <div class="dim-rule mt-8"></div>
    <div class="mt-10 grid gap-12 lg:grid-cols-[2fr_1fr]">
      {tracks.map((tr) => {
        const items = programs.programs.filter((p) => p.group === tr.key);
        return (
          <section class:list={[tr.key === 'eng' && 'lg:row-span-2']}>
            <h3 class="font-serif text-xl font-bold text-ink">{pick(tr.title, lang)}</h3>
            <p class="text-[15px] text-gold-ink">{pick(tr.note, lang)}</p>
            <ul class="mt-4 divide-y divide-line border-y border-line">
              {items.map((p) => (
                <li>
                  <a href={path(lang, `/education/programs/${p.slug}`)} class="group grid gap-x-6 gap-y-1 py-4 no-underline sm:grid-cols-[1fr_auto] sm:items-baseline">
                    <span>
                      <span class="block font-serif text-[21px] leading-snug font-bold text-maroon group-hover:underline group-hover:decoration-gold">{pick(p.name, lang)}</span>
                      <span class="block text-[15px] text-muted">{pick(p.summary, lang)}</span>
                    </span>
                    <span class="text-[15px] font-semibold whitespace-nowrap text-ink">{feeText(p)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </div>
    <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
      <a href={path(lang, '/education/programs')} class="link-quiet">{t(lang, 'cta.programs')}</a>
      <a href={path(lang, '/education/why-us')} class="link-quiet">{t(lang, 'nav.education.why')}</a>
    </div>
  </section>

  <!-- ข่าว -->
  <section class="bg-cream">
    <div class="container-site py-16 md:py-24">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="section-title">{t(lang, 'home.news.title')}</h2>
        <a href={path(lang, '/news')} class="link-quiet">{t(lang, 'cta.allNews')}</a>
      </div>
      <div class="dim-rule mt-6"></div>
      <div class="mt-10 grid gap-10 md:grid-cols-3">
        {news.map((n) => <NewsCard lang={lang} item={n} />)}
      </div>
    </div>
  </section>

  <!-- คุณภาพ -->
  <section class="container-site py-16 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <h2 class="section-title">{t(lang, 'home.quality.title')}</h2>
        <p class="mt-4 max-w-[40ch] text-muted">{L('เปิดเผยแผน ผลการดำเนินงาน และรายงานคุณภาพของคณะต่อสาธารณะ', 'Our plans, results and quality reports, published openly.')}</p>
      </div>
      <dl class="grid border-t border-line sm:grid-cols-2">
        {documents.quality.map((q) => (
          <div class="border-b border-line py-5 sm:odd:pr-8 sm:even:pl-8 sm:even:border-l">
            <dt><a href={q.url || path(lang, '/quality')} class="font-semibold text-maroon no-underline hover:underline hover:decoration-gold">{pick(q.title, lang)}</a></dt>
            <dd class="text-[15px] text-muted">{pick(q.desc, lang)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- สารจากคณบดี -->
  <section class="bg-maroon-deep text-white">
    <div class="container-site grid items-center gap-10 py-16 md:grid-cols-[260px_1fr] md:py-20">
      <div class="mx-auto aspect-[3/4] w-56 overflow-hidden border border-gold/60 p-1.5 md:w-full">
        {dean.photo ? <img src={dean.photo} alt={pick(dean.name, lang)} class="h-full w-full object-cover object-top" /> : <div class="blueprint h-full w-full"></div>}
      </div>
      <div>
        <h2 class="text-[15px] font-semibold text-gold-light">{t(lang, 'home.dean.eyebrow')}</h2>
        <blockquote class="mt-3 max-w-[40ch] font-serif text-[26px] leading-[1.6] md:text-[30px]">
          {L('“มุ่งเป็นเลิศด้านเทคโนโลยีและวิศวกรรมนักปฏิบัติของภาคตะวันออก สร้างบัณฑิตที่ทำงานได้จริง และเติบโตไปพร้อมกับอุตสาหกรรมในบ้านเกิด”',
             '“We aim to lead the East in hands-on technology and engineering, producing graduates who can do the work and grow with industry at home.”')}
        </blockquote>
        <p class="mt-6"><span class="block font-semibold text-gold-light">{pick(dean.name, lang)}</span><span class="text-[15px] text-parchment">{pick(dean.position, lang)}</span></p>
        <div class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-[15px]">
          <a href={path(lang, '/about/executives')} class="text-white underline decoration-gold underline-offset-[6px]">{t(lang, 'nav.about.executives')}</a>
          <a href={site.deanHotlineUrl} target="_blank" rel="noopener" class="text-white underline decoration-gold underline-offset-[6px]">{t(lang, 'nav.dean')}</a>
        </div>
      </div>
    </div>
  </section>
</Base>
