---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { t, pick } from '../../i18n/ui';
import { langPaths, langFromParam } from '../../lib/routes';
import site from '../../data/site.json';
export function getStaticPaths() { return langPaths(); }
const lang = langFromParam(Astro.params.lang);
const rows = [
  { label: t(lang, 'label.address'), value: pick(site.address, lang) },
  { label: t(lang, 'label.tel'), value: pick(site.phone, lang), href: `tel:${site.phoneTel}` },
  { label: t(lang, 'label.email'), value: site.email, href: `mailto:${site.email}` },
  { label: t(lang, 'footer.hours'), value: pick(site.hours, lang) },
  { label: 'Facebook', value: 'facebook.com/techno.rru.ac.th', href: site.social.facebook },
  { label: 'LINE OA', value: site.social.lineId, href: site.social.line },
];
---
<Base lang={lang} title={t(lang, 'nav.contact')}>
  <PageHero lang={lang} title={t(lang, 'nav.contact')} crumbs={[{ label: t(lang, 'nav.contact') }]} />
  <div class="container-site grid gap-10 py-12 md:py-16 lg:grid-cols-[1fr_1.2fr]">
    <div>
      <h2 class="font-serif text-2xl font-bold text-maroon">{t(lang, 'faculty.name')}</h2>
      <p class="text-muted">{t(lang, 'univ.name')}</p>
      <dl class="mt-6 divide-y divide-line border-y border-line">
        {rows.map((r) => (
          <div class="grid grid-cols-[110px_1fr] gap-4 py-3">
            <dt class="text-sm font-semibold text-gold-ink">{r.label}</dt>
            <dd>{r.href ? <a href={r.href} target={r.href.startsWith('http') ? '_blank' : undefined} rel="noopener" class="text-maroon">{r.value}</a> : r.value}</dd>
          </div>
        ))}
      </dl>
      <a href={site.deanHotlineUrl} target="_blank" rel="noopener" class="mt-6 inline-block rounded bg-maroon px-5 py-3 font-semibold text-white no-underline hover:bg-maroon-dark">{t(lang, 'nav.dean')} ↗</a>
    </div>
    <iframe src={site.mapEmbed} title={lang === 'th' ? 'แผนที่' : 'Map'} loading="lazy" class="h-[420px] w-full rounded-md border border-line" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
</Base>
