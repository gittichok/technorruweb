---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import DocList from '../../../components/DocList.astro';
import { t } from '../../../i18n/ui';
import { langPaths, langFromParam } from '../../../lib/routes';
import documents from '../../../data/documents.json';
export function getStaticPaths() { return langPaths(); }
const lang = langFromParam(Astro.params.lang);
---
<Base lang={lang} title={t(lang, 'nav.services.forms')}>
  <PageHero lang={lang} title={t(lang, 'nav.services.forms')} crumbs={[{ label: t(lang, 'nav.services'), href: '/services/students' }, { label: t(lang, 'nav.services.forms') }]} />
  <div class="container-site max-w-3xl space-y-10 py-12 md:py-16">
    <section><h2 class="mb-4 font-serif text-2xl font-bold text-maroon">{t(lang, 'nav.services.students')}</h2><DocList lang={lang} items={[...documents.regulations, ...documents.studentForms]} /></section>
    <section><h2 class="mb-4 font-serif text-2xl font-bold text-maroon">{t(lang, 'nav.services.staff')}</h2><DocList lang={lang} items={documents.staffForms} /></section>
  </div>
</Base>
