---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import PersonCard from '../../../components/PersonCard.astro';
import { t, pick } from '../../../i18n/ui';
import people from '../../../data/people.json';
import { langPaths, langFromParam } from '../../../lib/routes';
export function getStaticPaths() { return langPaths(); }
const lang = langFromParam(Astro.params.lang);
const [dean, ...rest] = people.executives;
---
<Base lang={lang} title={t(lang, 'nav.about.executives')}>
  <PageHero lang={lang} title={t(lang, 'nav.about.executives')} crumbs={[{ label: t(lang, 'nav.about'), href: '/about/history' }, { label: t(lang, 'nav.about.executives') }]} />
  <div class="container-site py-12 md:py-16">
    <div class="mx-auto max-w-sm"><PersonCard name={pick(dean.name, lang)} position={pick(dean.position, lang)} photo={dean.photo} featured /></div>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((p) => <PersonCard name={pick(p.name, lang)} position={pick(p.position, lang)} photo={p.photo} />)}
    </div>
  </div>
</Base>
