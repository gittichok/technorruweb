    <p class="font-serif text-7xl font-bold text-maroon">404</p>
    <h1 class="mt-4 text-2xl font-semibold">ไม่พบหน้าที่คุณต้องการ · Page not found</h1>
    <div class="mt-8 flex justify-center gap-4">
      <a href="/" class="rounded bg-maroon px-5 py-3 font-semibold text-white no-underline">กลับหน้าแรก</a>
      <a href="/en/" class="rounded border border-maroon px-5 py-3 font-semibold text-maroon no-underline">Back to home</a>
    </div>
  </div>
</Base>
